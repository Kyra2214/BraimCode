{
  "schema_version": 1,
  "purpose": "Policy for discovering, validating and activating external skills.",
  "rules": {"catalog_is_not_authorization":true,"external_skills_default_trust":"unverified","load_full_skill_only_after_metadata_match":true,"verify_source_repository":true,"verify_license_before_distribution":true,"validate_manifest_before_activation":true,"scan_for_malicious_or_instruction_injection_patterns":true,"record_provenance":true,"record_content_hash":true,"policy_broker_is_final_authority":true},
  "provenance_fields":["source_id","repository","path","source_url","content_hash","license","retrieved_at","validated_at","trust_level"]
}
